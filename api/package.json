{
  "name": "kritzellm-api-tools",
  "private": true,
  "description": "Tooling for the kritzeLLM OpenAPI contract: lint and mock server",
  "type": "module",
  "scripts": {
    "lint": "redocly lint openapi.json",
    "mock": "prism mock --dynamic --json-schema-faker-fillProperties false openapi.json --port 4010"
  },
  "devDependencies": {
    "@redocly/cli": "2.64.1",
    "@stoplight/prism-cli": "5.16.0"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "lodash": "4.18.0",
    "uuid": "11.1.1"
  }
}
